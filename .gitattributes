# Text files are LF on every machine, whatever it uses: Windows' own tools all read LF nowadays.
* text=auto eol=lf
# Except Windows batch files: Command Prompt can miss a "call :label" in a batch file with LF endings.
*.cmd text eol=crlf
*.bat text eol=crlf

# Generated by tools\make_scripts.py from the WorldVoice add-on.
common/ScriptData.h linguist-generated=true

*.dll binary
*.exe binary
